# Keitaro Admin API: адрес трекера и ключ из админки
KEITARO_BASE_URL=https://tlgk.host
KEITARO_API_KEY=

# Обязательный префикс имён кампаний
CAMPAIGN_NAME_PREFIX=test_bulygin_

# Хранилище: postgres (SQLAlchemy) или mongo
STORAGE_BACKEND=postgres
DATABASE_URL=postgresql+asyncpg://keitaro:keitaro@db:5432/keitaro
MONGO_URL=mongodb://mongo:27017
MONGO_DB=keitaro

# Адрес GraphQL бэкенда для BFF (внутренняя сеть compose)
NUXT_BACKEND_GRAPHQL_URL=http://backend:8000/graphql

# Порт фронта на хосте
FRONTEND_PORT=3000
